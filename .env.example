# Database Connection String (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/api_sentinel"

# Redis Queue Connection String (BullMQ)
REDIS_URL="redis://localhost:6379"

# (Optional) SMTP Email Notification Settings
# If omitted, simulated email alerts are cleanly logged in the terminal
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="alerts@yourdomain.com"

# Environment
NODE_ENV="development"
PORT="3000"
