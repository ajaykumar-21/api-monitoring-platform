# ========================================================
# API Sentinel Environment Configuration
# ========================================================

# --------------------------------------------------------
# 1. Database Connection (PostgreSQL)
# --------------------------------------------------------
# For Docker Compose (Default):
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/api_sentinel"
# For Local Host Development (without Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/api_sentinel"

# --------------------------------------------------------
# 2. Redis Queue Connection (BullMQ)
# --------------------------------------------------------
# For Docker Compose (Default):
REDIS_URL="redis://redis:6379"
# For Local Host Development (without Docker):
# REDIS_URL="redis://localhost:6379"

# --------------------------------------------------------
# 3. (Optional) Email Alert Notifications (SMTP)
# --------------------------------------------------------
# If omitted, alert emails will be simulated and logged in terminal
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="alerts@api-sentinel.com"

# --------------------------------------------------------
# 4. App Server Configuration
# --------------------------------------------------------
NODE_ENV="production"
PORT="3000"
